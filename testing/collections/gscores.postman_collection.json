{
  "info": {
    "name": "G-Scores API",
    "description": "Black-box API tests for G-Scores, run with newman (see testing/README.md).\n\nThey assert real values from the 2024 dataset (1,061,605 candidates), so run them against a fully seeded stack. Dataset-specific expectations live in the environment files, not in the requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('answers with JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/));",
          "const budget = Number(pm.variables.get('maxResponseMs') || 1500);",
          "pm.test('responds within ' + budget + ' ms', () => pm.expect(pm.response.responseTime).to.be.below(budget));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health and catalog",
      "description": "Liveness probe and the subject / group catalog.",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok (database reachable)', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": ""
          }
        },
        {
          "name": "GET /subjects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('lists the nine subjects in order', () => {",
                  "  pm.expect(body.subjects.map((s) => s.code)).to.eql(['toan','ngu_van','ngoai_ngu','vat_li','hoa_hoc','sinh_hoc','lich_su','dia_li','gdcd']);",
                  "});",
                  "pm.test('lists the five groups', () => {",
                  "  pm.expect(body.groups.map((g) => g.code)).to.eql(['A00','A01','B00','C00','D01']);",
                  "});",
                  "pm.test('group A00 is Toan + Vat li + Hoa hoc', () => {",
                  "  pm.expect(body.groups.find((g) => g.code === 'A00').subjects).to.eql(['toan','vat_li','hoa_hoc']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/subjects",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Score lookup",
      "description": "GET /students/:sbd — success, validation and not-found paths.",
      "item": [
        {
          "name": "Known candidate: full score sheet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const by = Object.fromEntries(b.scores.map((s) => [s.subject.code, s]));",
                  "pm.test('echoes the candidate number', () => pm.expect(b.sbd).to.eql(pm.variables.get('knownSbd')));",
                  "pm.test('returns all nine subjects', () => pm.expect(b.scores).to.have.lengthOf(9));",
                  "pm.test('Toan 8.4 is level excellent (>= 8)', () => pm.expect(by.toan).to.include({ score: 8.4, level: 'excellent' }));",
                  "pm.test('Ngu van 6.75 is good, Hoa hoc 5.25 and Sinh hoc 5 are average', () => {",
                  "  pm.expect(by.ngu_van).to.include({ score: 6.75, level: 'good' });",
                  "  pm.expect(by.hoa_hoc).to.include({ score: 5.25, level: 'average' });",
                  "  pm.expect(by.sinh_hoc).to.include({ score: 5, level: 'average' });",
                  "});",
                  "pm.test('a subject the candidate did not take has null score and level', () => {",
                  "  pm.expect(by.lich_su).to.include({ score: null, level: null });",
                  "});",
                  "pm.test('foreign language is resolved from the code', () => pm.expect(b.foreignLanguage).to.eql('Tiếng Anh'));",
                  "pm.test('group totals only for complete groups (A00, A01, B00, D01; C00 needs Lich su)', () => {",
                  "  const totals = Object.fromEntries(b.groups.map((g) => [g.code, g.total]));",
                  "  pm.expect(totals).to.eql({ A00: 19.65, A01: 22.4, B00: 18.65, D01: 23.15 });",
                  "});",
                  "pm.test('every level is one of the four known values or null', () => {",
                  "  b.scores.forEach((s) => pm.expect([null, 'excellent', 'good', 'average', 'poor']).to.include(s.level));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students/{{knownSbd}}",
            "description": ""
          }
        },
