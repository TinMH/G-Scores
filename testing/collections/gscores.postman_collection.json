    {
      "name": "Reports",
      "description": "GET /reports/score-levels — the four score levels per subject.",
      "item": [
        {
          "name": "Score levels for all subjects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const counts = Object.fromEntries(b.subjects.map((s) => [s.code, s.counts]));",
                  "const sum = (c) => c.excellent + c.good + c.average + c.poor;",
                  "pm.test('four levels in order: >= 8, 6-8, 4-6, < 4', () => {",
                  "  pm.expect(b.levels.map((l) => l.level)).to.eql(['excellent','good','average','poor']);",
                  "});",
                  "pm.test('nine subjects, counts are non-negative integers', () => {",
                  "  pm.expect(b.subjects).to.have.lengthOf(9);",
                  "  b.subjects.forEach((s) => Object.values(s.counts).forEach((n) => pm.expect(Number.isInteger(n) && n >= 0).to.be.true));",
                  "});",
                  "pm.test('Toan counts match the 2024 dataset', () => {",
                  "  pm.expect(counts.toan).to.eql({ excellent: 198392, good: 505836, average: 258654, poor: 82731 });",
                  "});",
                  "pm.test('Toan was taken by 1,045,613 candidates', () => pm.expect(sum(counts.toan)).to.eql(1045613));",
                  "const papers = b.subjects.reduce((acc, s) => acc + sum(s.counts), 0);",
                  "pm.collectionVariables.set('papersFromReport', String(papers));",
                  "pm.test('all subjects together: ' + papers + ' papers', () => pm.expect(papers).to.eql(Number(pm.variables.get('totalPapers'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reports/score-levels",
            "description": ""
          }
        }
      ]
    },
