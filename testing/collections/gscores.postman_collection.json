    {
      "name": "Overview",
      "description": "GET /overview — dashboard numbers (pre-aggregated).",
      "item": [
        {
          "name": "Totals, top scorers and per-subject stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('dataset totals', () => {",
                  "  pm.expect(b.totals).to.eql({",
                  "    candidates: Number(pm.variables.get('totalCandidates')),",
                  "    papers: Number(pm.variables.get('totalPapers')),",
                  "    perfectScores: Number(pm.variables.get('totalPerfectScores')),",
                  "  });",
                  "});",
                  "pm.test('papers equal the sum of all score levels from /reports (cross-endpoint consistency)', () => {",
                  "  const fromReport = pm.collectionVariables.get('papersFromReport');",
                  "  if (fromReport === undefined) { pm.expect.fail('run the Reports folder first'); }",
                  "  pm.expect(String(b.totals.papers)).to.eql(fromReport);",
                  "});",
                  "pm.test('overall top scorer is C00 / 19000335 / 29.75', () => {",
                  "  pm.expect(b.topScorer.group.code).to.eql('C00');",
                  "  pm.expect([b.topScorer.sbd, b.topScorer.total]).to.eql(['19000335', 29.75]);",
                  "});",
                  "pm.test('one top scorer per group, each below 30', () => {",
                  "  pm.expect(b.groupTopScorers.map((s) => [s.group.code, s.sbd, s.total])).to.eql([",
                  "    ['A00','26020938',29.6], ['A01','02038432',29.6], ['B00','03015805',29.55], ['C00','19000335',29.75], ['D01','16000274',28.75],",
                  "  ]);",
                  "});",
                  "pm.test('nine subjects with sane averages (0..10) and counts', () => {",
                  "  pm.expect(b.subjects).to.have.lengthOf(9);",
                  "  b.subjects.forEach((s) => {",
                  "    pm.expect(s.average).to.be.within(0, 10);",
                  "    pm.expect(s.taken).to.be.above(0);",
                  "    pm.expect(s.taken).to.be.at.most(b.totals.candidates);",
                  "  });",
                  "});",
                  "pm.test('Toan average 6.45, Dia li has the most perfect scores among the two', () => {",
                  "  const by = Object.fromEntries(b.subjects.map((s) => [s.code, s]));",
                  "  pm.expect(by.toan.average).to.eql(6.45);",
                  "  pm.expect(by.dia_li.perfectScores).to.be.above(by.vat_li.perfectScores);",
                  "});",
                  "pm.test('perfect scores add up to the total', () => {",
                  "  pm.expect(b.subjects.reduce((a, s) => a + s.perfectScores, 0)).to.eql(b.totals.perfectScores);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/overview",
            "description": ""
          }
        }
      ]
    }
